# ── Telegraph node ────────────────────────────────────────────────────────────
# All HTTP services hang off one base URL: /engine, /miner-dispatcher, /daemon
NODE_URL=http://13.237.89.59:7044
WS_URL=ws://13.237.89.59:7044/engine/ws

# ── Chain (Base Sepolia) ──────────────────────────────────────────────────────
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# ── Wallets ───────────────────────────────────────────────────────────────────
# The wallet the examples act as. Needs Base Sepolia ETH + USDC — run
# `npm run fund-agent` once (with FUNDER_PRIVATE_KEY set) to set it up.
AGENT_PRIVATE_KEY=0x...

# Optional: a funded wallet used only by `npm run fund-agent` to top up the agent.
FUNDER_PRIVATE_KEY=

# ── WebSocket subscription example ────────────────────────────────────────────
SUBSCRIBE_INTENTS=CHAT_COMPLETION,WEATHER_FORECAST,WEB_SEARCH,RESEARCH_SYNTHESIS
# Stop after N pushed signals (0 = run until Ctrl-C)
MAX_SIGNALS=3
# Give up if no signal arrives within this many seconds
SIGNAL_TIMEOUT_SECONDS=300
